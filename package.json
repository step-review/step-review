{
  "name": "@step-review/root",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @step-review/app --filter @step-review/session-server dev",
    "build": "pnpm -r --if-present build",
    "check-translations": "pnpm -r --if-present check-translations",
    "check-types": "pnpm -r --if-present check-types",
    "check-formatting": "oxfmt --check .",
    "fix-formatting": "oxfmt --write .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint-fix": "oxlint --type-aware --deny-warnings --fix .",
    "test": "pnpm -r --if-present test",
    "qa": "pnpm check-formatting && pnpm lint && pnpm check-types && pnpm check-translations && pnpm test",
    "deploy-site": "pnpm --filter @step-review/app deploy-site",
    "cleanup-preview": "pnpm --filter @step-review/app cleanup-preview",
    "release:prepare": "node packages/tooling/release/src/prepareRelease.ts",
    "release:publish": "node packages/tooling/release/src/publishRelease.ts"
  },
  "devDependencies": {
    "@step-review/oxlint-custom-rules": "workspace:*",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  }
}
