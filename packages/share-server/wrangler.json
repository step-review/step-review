{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "step-review-share-server-local",
  "main": "./src/server/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "SHARES", "class_name": "ShareObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShareObject"] }],
  "ratelimits": [
    {
      "name": "REVIEW_UPLOADS",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
