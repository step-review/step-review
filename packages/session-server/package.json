{
  "name": "@step-review/session-server",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test-server": "./src/test-utils/startSessionServer.ts"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port ${SESSION_SERVER_PORT:-8787}",
    "check-types": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "26.6.5",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
