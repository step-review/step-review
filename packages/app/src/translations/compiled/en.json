  ],
  "Privacy.tsx_UNX1+0": [
    {
      "type": 0,
      "value": "The review files you open, the files you mark as viewed, the sessions you joined (with the keys that open them), your name in sessions and your display preferences are stored in your browser's local storage. "
    },
    {
      "type": 8,
      "value": "strong",
      "children": [
        {
          "type": 0,
          "value": "They are not sent to us"
        }
      ]
    },
    {
      "type": 0,
      "value": ", except as described for sessions below."
    }
  ],
  "Privacy.tsx_Vwbc0H": [
    {
      "type": 0,
      "value": "Step Review is built so that your code stays with you: there are no accounts, no cookies and no tracking, and reviews you open never leave your browser unless you start a collaboration session. This page explains what data Step Review handles, where, and why."
    }
  ],
  "Privacy.tsx_WmroJ6": [
    {
      "type": 0,
      "value": "Data kept in your browser"
    }
  ],
  "Privacy.tsx_cXBJ7U": [
    {
      "type": 0,
      "value": "Privacy"
    }
  ],
  "Privacy.tsx_cufYZU": [
    {
      "type": 0,
      "value": "If what Step Review does with data changes, we'll update this page and its date."
    }
  ],
  "Privacy.tsx_cxQ2EY": [
    {
      "type": 0,
      "value": "The server stores the encrypted data and hashes of the secrets that let participants in. It can see how large a session is, when it's used, and how many participants it has. A session is deleted when its owner ends it, or after 30 days without activity."
    }
  ],
  "Privacy.tsx_dgqhUM": [
