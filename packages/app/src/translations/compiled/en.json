  "Privacy.tsx_hbVyuj": [
    {
      "type": 0,
      "value": "We rely on our legitimate interest in understanding how Step Review is used, so that we can improve it (Article 6(1)(f) GDPR)."
    }
  ],
  "Privacy.tsx_iDEnD2": [
    {
      "type": 0,
      "value": "When you start a session, the review is uploaded to our server so that others can join it. Before anything leaves your browser, the review, each participant's name and viewed files, and the step each participant is on are "
    },
    {
      "type": 8,
      "value": "strong",
      "children": [
        {
          "type": 0,
          "value": "end-to-end encrypted"
        }
      ]
    },
    {
      "type": 0,
      "value": ", with a key that only the session's links hold. Browsers never send that part of a link, so we can't read any of this data."
    }
  ],
  "Privacy.tsx_m9nuC7": [
    {
      "type": 0,
      "value": "Cloudflare processes this data on our behalf under its data processing addendum. It may do so outside the European Economic Area, protected by the EU Standard Contractual Clauses. We rely on our legitimate interest in running a secure, reliable service (Article 6(1)(f) GDPR)."
    }
  ],
