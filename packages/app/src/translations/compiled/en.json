      "type": 0,
      "value": "."
    }
  ],
  "Privacy.tsx_KEWCI1": [
    {
      "type": 0,
      "value": "Step Review is hosted by "
    },
    {
      "type": 1,
      "value": "cloudflare"
    },
    {
      "type": 0,
      "value": ", which processes your IP address and standard request information to deliver the site and protect it from attacks, and may keep it in short-lived logs. To prevent abuse, the server also limits how many sessions an IP address can start per minute; it only keeps those counts for that minute."
    }
  ],
  "Privacy.tsx_RuHI4i": [
    {
      "type": 0,
      "value": "This storage is needed for Step Review to work, so it doesn't require consent. You can remove a review from the start page, or remove everything by clearing this site's data in your browser."
    }
  ],
  "Privacy.tsx_SaUZGt": [
    {
      "type": 0,
      "value": "You also have the right to lodge a complaint with a data protection authority, in particular the one where you live or work."
    }
  ],
  "Privacy.tsx_T33gk/": [
