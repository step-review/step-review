  "Privacy.tsx_+pPNRT": [
    {
      "type": 0,
      "value": "Step Review runs no analytics scripts. To see how much it's used, we look at the aggregate statistics Cloudflare computes from the requests it serves, such as the number of page views and visitors per day and the countries they come from. Nothing runs on or is read from your device for this."
    }
  ],
  "Privacy.tsx_5cxCIW": [
    {
      "type": 0,
      "value": "Hosting and network data"
    }
  ],
  "Privacy.tsx_CUYkvi": [
    {
      "type": 0,
      "value": "Under the GDPR, you can ask us to access, correct or erase your personal data, to restrict or stop processing it, and to hand it over in a portable format. As we don't know who you are and can't read sessions, we usually can't tell which data is yours: ending a session you own, or clearing this site's data in your browser, is the quickest way to erase it."
    }
  ],
  "Privacy.tsx_GZJpDf": [
    {
      "type": 0,
      "value": "Analytics"
    }
  ],
