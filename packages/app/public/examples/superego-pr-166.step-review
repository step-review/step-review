       :root {
         color-scheme: light dark;
         font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
       }
       body {
         line-height: 1.5;
         margin: 40px;
         max-width: 720px;
       }
       h1 {
         font-size: 24px;
         margin: 0 0 16px;
       }
       p {
         margin: 0 0 12px;
       }
       code {
         font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
       }
