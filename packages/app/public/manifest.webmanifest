{
  "name": "Step Review",
  "short_name": "Step Review",
  "description": "A better way to review PRs.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": { "application/x-step-review": [".step-review"] }
    }
  ]
}
