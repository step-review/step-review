{
  "name": "@step-review/app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "check-translations": "node scripts/checkTranslations.ts",
    "test": "vitest run",
    "translations:extract": "formatjs extract 'src/**/*.ts*' --ignore='**/*.d.ts' --id-interpolation-pattern='[name].[ext]_[sha512:contenthash:base64:6]' --out-file src/translations/en.json",
    "translations:compile": "formatjs compile-folder --ast src/translations/ src/translations/compiled",
    "translations:verify": "formatjs verify --missing-keys --structural-equality --source-locale en 'src/translations/*.json'",
    "deploy-site": "node scripts/deploy.ts",
    "cleanup-preview": "node scripts/cleanup.ts"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource/cousine": "5.3.0",
    "@primer/octicons-react": "19.42.0",
    "@primer/primitives": "11.10.0",
    "@primer/react": "38.43.0",
    "@step-review/review-format": "workspace:*",
    "@step-review/session-server": "workspace:*",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "diff": "9.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.1.4",
    "react-intl": "12.1.5",
    "react-is": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@formatjs/cli": "6.16.35",
    "@formatjs/unplugin": "1.2.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0",
    "wrangler": "4.152.0",
    "zx": "8.8.5"
  }
}
